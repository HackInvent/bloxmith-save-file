{
  "kind": "save_file",
  "version": "0.1.0",
  "bloxsmith_compatibility": ["1.0.9"],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Enregistrer",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "contenu",
        "title": "In",
        "accepts": [
          "message/*"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      },
      {
        "id": 2,
        "name": "path",
        "title": "Path",
        "accepts": [
          "file/path",
          "text/plain",
          "message/*",
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": []
  },
  "optional_ports": {
    "outputs": [
      {
        "id": 1,
        "name": "done",
        "title": "Done",
        "emits": [
          "control/trigger",
          "message/*"
        ],
        "multiplicity": "many",
        "description": "Operational trigger emitted only after the file write succeeds."
      }
    ]
  },
  "config": {
    "path": "exports/resultat.txt",
    "mode": "overwrite",
    "append": false,
    "encoding": "utf-8"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "file_browser": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  }
}
